# Copy to .env and load with:  set -a; . ./.env; set +a
# bin/kb reads these from the environment; it does not read .env by itself.
# Every one is optional — the defaults keep all state inside this repo for local work.

# Who you are. An actor id from governance/roles.yaml. Unset means read-only, and the
# pre-commit hook refuses unattributed commits. `bin/kb whoami` shows your scope.
KB_ACTOR=agent.compile-01

# --- production locations (see ops/tigerfs.md) --------------------------------
# Set all four explicitly on a real deployment. The raw store and control state belong on
# their own TigerFS workspaces, not wherever a task worktree happens to sit.

# The shared bare repository.            default: this repo
#KB_GIT_DIR=/mnt/ai-kb/kb-git/knowledge.git

# One linked worktree per write task.    default: <repo>/.worktrees
#KB_WORKTREES=/mnt/ai-kb/kb-git/worktrees

# Content-addressed immutable sources.   default: <repo>/.raw
#KB_RAW=/mnt/ai-kb/kb-raw

# Task records and leases.               default: <repo>/.kb
#KB_CONTROL=/mnt/ai-kb/kb-control

# --- behaviour ----------------------------------------------------------------

# Minutes before a task lease expires. A crashed agent's claim lapses; its worktree and
# commits survive.                       default: 120
#KB_LEASE_MIN=120

# Python interpreter for the validators (stdlib only, 3.9+).
#PYTHON=python3
